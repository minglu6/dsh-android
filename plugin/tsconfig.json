{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["react", "react-dom"]
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx", "tsdown.config.ts"]
}
