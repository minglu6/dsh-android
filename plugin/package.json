{
  "name": "dsh-plugin-pocket",
  "version": "0.1.0",
  "description": "Bridge plugin for the dsh-android native app: a small authenticated JSON/WebSocket protocol over DeepSeek Harness sessions",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "android", "remote"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/minglu6/dsh-android.git", "directory": "plugin" },
  "type": "module",
  "main": "index.js",
  "exports": { ".": "./index.js", "./package.json": "./package.json" },
  "bin": { "dsh-pocket": "bin/pocket.js" },
  "files": ["index.js", "src", "bin", "cordis.patch.yml", "README.md"],
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "ws": "^8.18.0" },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.2 <0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-session-controller": { "optional": true }
  },
  "devDependencies": { "eslint": "^9.14.0", "@eslint/js": "^9.14.0", "globals": "^15.12.0" }
}
